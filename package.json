{
  "name": "@my-scope/node-red-sample",
  "version": "0.4.0",
  "description": "Description of the node set here",
  "repository": "https://github.com/alexk111/node-red-node-typescript-starter",
  "keywords": [
    "node-red"
  ],
  "author": "Alex Kaul",
  "node-red": {
    "version": ">=1.3.0",
    "nodes": {
      "transform-text": "./dist/nodes/transform-text/transform-text.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "add-node": "node ./utils/add-node.cjs",
    "copy": "copyfiles -u 2 \"./src/nodes/**/*.{png,svg}\" \"./dist/nodes/\"",
    "build:editor": "rollup -c rollup.config.editor.js",
    "build:editor:watch": "rollup -c rollup.config.editor.js -w",
    "build:runtime": "tsc -p tsconfig.runtime.json",
    "build:runtime:watch": "tsc -p tsconfig.runtime.watch.json --watch --preserveWatchOutput",
    "build": "rm -rf dist && npm run copy && npm run build:editor && npm run build:runtime",
    "start": "npm run nr:setup && npm run nr:start",
    "validate": "npx node-red-dev validate",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit --detectOpenHandles --colors",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --forceExit --detectOpenHandles --watchAll",
    "nr:setup": "cp -n ./node_modules/node-red/settings.js ./node-red-data/settings.cjs && cd node-red-data && npm install ..",
    "nr:start": "./node_modules/.bin/node-red -u ./node-red-data -s ./node-red-data/settings.cjs",
    "nr:watch": "nodemon --watch dist --ext js,html,gif,jpg,png,webp,svg --delay 5 --exec \"./node_modules/.bin/node-red -u ./node-red-data -s ./node-red-data/settings.cjs\"",
    "dev": "rm -rf dist && npm run copy && npm run nr:setup && concurrently --kill-others --names 'COPY,EDITOR,RUNTIME,TEST,NODE-RED' --prefix '({name})' --prefix-colors 'yellow.bold,cyan.bold,greenBright.bold,magenta.bold' 'onchange -v \"src/**/*.png\" \"src/**/*.svg\" -- npm run copy' 'npm run build:editor:watch' 'npm run build:runtime:watch' 'sleep 10; npm run test:watch' 'sleep 10; npm run nr:watch'",
    "lint": "prettier --check '**/*.{js,ts,md}'; eslint --ext .js,.ts .",
    "lint:fix": "prettier --write '**/*.{js,ts,md}'; eslint --ext .js,.ts . --fix"
  },
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/node-red": "^1.3.5",
    "@types/node-red-node-test-helper": "^0.3.5",
    "@types/sinon": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "colorette": "^2.0.20",
    "concurrently": "^10.0.4",
    "copyfiles": "^2.4.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-prettier": "^5.5.6",
    "glob": "^13.0.6",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "mustache": "^4.2.0",
    "node-red": "^5.0.1",
    "node-red-node-test-helper": "^0.3.6",
    "nodemon": "^3.1.14",
    "onchange": "^7.1.0",
    "prettier": "^3.9.6",
    "rollup": "^4.62.3",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
